# Thorondor production image deployment overlay.
# Load after .env.example:
# docker compose --env-file .env.example --env-file .env.production.example -f docker-compose.production.yml config

THORONDOR_ORCHESTRATOR_IMAGE=ghcr.io/feanorscodesl/thorondor-orchestrator:0.1.0
THORONDOR_CHUNKER_IMAGE=ghcr.io/feanorscodesl/thorondor-chunker:0.1.0
THORONDOR_EGRESS_PROXY_IMAGE=ghcr.io/feanorscodesl/thorondor-egress-proxy:0.1.0

# Keep these digest-pinned by default. Replace with GHCR mirror refs if the
# production host cannot pull Docker Hub directly.
THORONDOR_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference@sha256:b3e0169969c0dc4b22ab6bf6ad5699374d4cb720fc43fb66868a679586ea806f
THORONDOR_SEARXNG_IMAGE=searxng/searxng@sha256:02d441bbb647b7be422d21041420115cddadac4644368f67c7c7f407bbe72e22
THORONDOR_CRAWL4AI_IMAGE=unclecode/crawl4ai@sha256:b243f684ad20f71ee108ab3fc3f31f3349eb5b31a9947b9e563d868417141aad

# Tengwar's production Compose stack should provide this external network.
THORONDOR_APP_NETWORK=app-network

# In production, mount a copied SearXNG config directory, not the Thorondor
# source tree. The repo path is only for local Compose validation.
THORONDOR_SEARXNG_CONFIG_DIR=./searxng

# Tengwar owns the model servers; Thorondor consumes them over app-network.
EMBEDDING_ENDPOINT=http://embedding:8000
EMBEDDING_MODEL=bge-m3
RERANKER_ENDPOINT=http://reranker:8000
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_PATH=/rerank
RERANKER_HEALTH_PATH=/health

# Production service names differ from the local development Compose file.
CHUNKER_URL=http://thorondor-chunker:8000
CRAWL4AI_HTTP_PROXY=http://thorondor-egress-proxy:8888
CRAWL4AI_HTTPS_PROXY=http://thorondor-egress-proxy:8888
CRAWL4AI_ALL_PROXY=http://thorondor-egress-proxy:8888
