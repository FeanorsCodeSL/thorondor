Screen {
    background: #0B0B0B;
    color: #F2C04B;
}

#dashboard {
    layout: vertical;
    width: 1fr;
    height: 1fr;
    background: #0B0B0B;
    padding: 0 1;
    border: double #F2C04B;
    border-title-align: center;
    border-title-color: #F2C04B;
    border-title-style: bold;
    border-subtitle-align: center;
    border-subtitle-color: #8A6E2F;
}

#dashboard-body {
    layout: horizontal;
    height: 1fr;
}

#dashboard-nav {
    width: 32;
    min-width: 26;
    height: 1fr;
    background: #0B0B0B;
    border: round #5C4520;
    border-title-align: left;
    border-title-color: #D6A93D;
    padding: 0 1;
}

#dashboard-main {
    width: 1fr;
    height: 1fr;
    border: round #5C4520;
    border-title-align: left;
    border-title-color: #D6A93D;
    padding: 0 1;
}

.brand {
    background: #0B0B0B;
    color: #F2C04B;
    text-style: bold;
    height: auto;
    padding: 0 1;
}

#brand {
    height: auto;
    border: none;
    padding: 0 1;
}

.meta {
    color: #D6A93D;
    height: 1;
    padding: 0 1;
}

#harness {
    height: auto;
    min-height: 2;
    color: #D6A93D;
}

#components-title {
    color: #F2C04B;
    text-style: bold;
    height: 1;
}

#components {
    height: 1fr;
    min-height: 5;
    background: #0B0B0B;
    color: #F2C04B;
}

#components > .datatable--header {
    background: #0B0B0B;
    color: #D6A93D;
    text-style: bold;
}

#components > .datatable--cursor {
    background: #F2C04B;
    color: #0B0B0B;
}

.status {
    color: #F2C04B;
    min-height: 3;
    max-height: 6;
}

#actions-title {
    color: #F2C04B;
    text-style: bold;
    height: 1;
}

#action-menu {
    height: auto;
    min-height: 8;
    background: #0B0B0B;
    color: #F2C04B;
    margin: 1 0;
}

#action-menu > .option-list--option-highlighted {
    background: #F2C04B;
    color: #0B0B0B;
}

#mode-title,
#endpoints-title,
#search-title,
#validate-title,
#deploy-title,
#harness-mcp-title {
    height: 3;
}

#mode-form,
#endpoints-form,
#search-form,
#validate-body,
#deploy-body,
#harness-mcp-form {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

.field-label {
    color: #D6A93D;
    height: 1;
    width: auto;
}

.form-row {
    height: auto;
}

#mode-status,
#endpoints-status,
#search-status,
#validate-status,
#deploy-status,
#harness-mcp-status {
    min-height: 2;
}
