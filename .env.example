# Thorondor local configuration.
# Every key used by Compose and the Python settings loader is explicit here.
# Leave optional API keys and filters blank only when intentionally disabled.

SEARXNG_URL=http://searxng:8080
CRAWL4AI_URL=http://crawl4ai:11235
CHUNKER_URL=http://chunker:8000
SEARXNG_BASE_URL=http://searxng:8080/
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8080
LOG_LEVEL=INFO
HEALTHCHECK_TIMEOUT_S=2.0
HEALTHCHECK_MAX_CONNECTIONS=8
HEALTHCHECK_MAX_KEEPALIVE_CONNECTIONS=4
THORONDOR_ORCHESTRATOR_IMAGE=ghcr.io/feanorscodesl/thorondor-orchestrator:0.1.0
THORONDOR_CHUNKER_IMAGE=ghcr.io/feanorscodesl/thorondor-chunker:0.1.0
THORONDOR_EGRESS_PROXY_IMAGE=ghcr.io/feanorscodesl/thorondor-egress-proxy:0.1.0
THORONDOR_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference@sha256:af92a3852c965393cbdd111865c3a72445d2b430c7daf84269ffdb5cf178f4eb
THORONDOR_SEARXNG_IMAGE=searxng/searxng@sha256:f4c8e59de166ed71f6380c0847c312ca51f0d41996e31d0559163b6b09ecde52
THORONDOR_CRAWL4AI_IMAGE=unclecode/crawl4ai@sha256:bd36741e7bdd35ddc1a05d9183e1d6d8cefb61dd640d944a25d026b76e917690
THORONDOR_SEARXNG_CONFIG_DIR=./searxng
MARKDOWN_EXTRACTOR=trafilatura
MARKDOWN_EXTRACTOR_FAVOR_RECALL=true
MARKDOWN_EXTRACTOR_INCLUDE_COMMENTS=false
MARKDOWN_EXTRACTOR_INCLUDE_TABLES=true
MARKDOWN_EXTRACTOR_DEDUPLICATE=true
MAX_SUBQUERIES=3
SEARCH_PROFILE_QUICK_TOKEN_BUDGET=2000
SEARCH_PROFILE_QUICK_MAX_URLS=5
SEARCH_PROFILE_QUICK_MAX_PASSAGES=5
SEARCH_PROFILE_RESEARCH_TOKEN_BUDGET=8000
SEARCH_PROFILE_RESEARCH_MAX_URLS=12
SEARCH_PROFILE_RESEARCH_MAX_PASSAGES=20
SEARCH_PROFILE_DEEP_TOKEN_BUDGET=16000
SEARCH_PROFILE_DEEP_MAX_URLS=20
SEARCH_PROFILE_DEEP_MAX_PASSAGES=40
URL_SAFETY_BLOCKED_IP_CATEGORIES=loopback,link_local,private,reserved,multicast,unspecified
URL_SAFETY_BLOCKED_SPECIAL_IPS=169.254.169.254,fd00:ec2::254
URL_SAFETY_NAT64_NETWORKS=64:ff9b::/96
URL_SAFETY_SIX_TO_FOUR_NETWORKS=2002::/16
URL_SAFETY_IPV4_COMPAT_NETWORKS=::/96
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,thorondor:*,orchestrator:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*,http://thorondor:*,http://orchestrator:*

EMBEDDING_ENDPOINT=http://embedding:80
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_S=60
CHUNKER_LOG_LEVEL=INFO
CHUNKER_DEFAULT_STRATEGY_VERSION=cluster-semantic@1
CHUNKER_MAX_SEGMENTS_DP=10000
REWARD_CACHE_MAX_SIZE=100000
CHUNKER_MEM_LIMIT=768m

RERANKER_ENDPOINT=http://reranker:80
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RERANKER_PATH=/rerank
RERANKER_HEALTH_PATH=/health
RERANKER_API_KEY=
RERANKER_BATCH_SIZE=32
RERANKER_TIMEOUT_S=30

LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=

MAX_URLS=6
CRAWL_CONCURRENCY=4
CRAWL_PER_HOST_CONCURRENCY=1
CRAWL_TIMEOUT_S=15
CRAWL_RESPECT_ROBOTS_TXT=true
CRAWL_VALIDATE_REDIRECTS=true
CRAWL_MAX_PREFLIGHT_REDIRECTS=5
DEFAULT_TOKEN_BUDGET=4000
RELEVANCE_SCORE_FLOOR=0.0
DOMAIN_BLOCKLIST=
DOMAIN_ALLOWLIST=
ALLOWLIST_ONLY=false
# Generated into .env by the deploy scripts.
SEARXNG_SECRET=
SEARXNG_API_KEY=
CRAWL4AI_API_KEY=
CHUNKER_API_KEY=

PROXY_LOG_LEVEL=INFO
PROXY_HOST=0.0.0.0
PROXY_PORT=8888
PROXY_MAX_HEADER_BYTES=65536
PROXY_READ_CHUNK_BYTES=4096
PROXY_RELAY_CHUNK_BYTES=65536
PROXY_BLOCKED_IP_CATEGORIES=loopback,link_local,private,reserved,multicast,unspecified
PROXY_BLOCKED_SPECIAL_IPS=169.254.169.254,fd00:ec2::254
PROXY_NAT64_NETWORKS=64:ff9b::/96
PROXY_SIX_TO_FOUR_NETWORKS=2002::/16
PROXY_IPV4_COMPAT_NETWORKS=::/96

CRAWL4AI_HTTP_PROXY=http://egress-proxy:8888
CRAWL4AI_HTTPS_PROXY=http://egress-proxy:8888
CRAWL4AI_ALL_PROXY=http://egress-proxy:8888
CRAWL4AI_NO_PROXY=

# BYO model endpoint examples:
# EMBEDDING_ENDPOINT=http://your-embedding-host:8082
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANKER_ENDPOINT=http://your-reranker-host:8081
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_PATH=/rerank
# RERANKER_HEALTH_PATH=/health
# RERANKER_BATCH_SIZE=32
# RERANKER_TIMEOUT_S=30
