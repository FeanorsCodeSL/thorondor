# Thorondor llama.cpp local model configuration.
# Copy this to .env.llamacpp, then place the referenced GGUF files under ./models.

LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server@sha256:2244d2b223b49912c7e0c31b4a3654e5e62cf19899f1f36ad30e785eac171a31

# Container paths are resolved through the ./models:/models:ro Compose mount.
LLAMACPP_EMBEDDING_MODEL=/models/bge-m3.gguf
LLAMACPP_EMBEDDING_ALIAS=bge-m3
LLAMACPP_EMBEDDING_POOLING=cls
LLAMACPP_EMBEDDING_CONTEXT=8192

LLAMACPP_RERANKER_MODEL=/models/bge-reranker-v2-m3.gguf
LLAMACPP_RERANKER_ALIAS=bge-reranker-v2-m3
LLAMACPP_RERANKER_CONTEXT=8192

LLAMACPP_BATCH=8192
LLAMACPP_UBATCH=8192
