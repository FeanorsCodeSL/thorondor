{
  "$defs": {
    "Citation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "published": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published"
        }
      },
      "required": [
        "id",
        "url",
        "title"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Passage": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "token_count": {
          "title": "Token Count",
          "type": "integer"
        },
        "citation_id": {
          "title": "Citation Id",
          "type": "integer"
        },
        "provenance": {
          "const": "external_web",
          "default": "external_web",
          "title": "Provenance",
          "type": "string"
        },
        "trust": {
          "const": "untrusted",
          "default": "untrusted",
          "title": "Trust",
          "type": "string"
        }
      },
      "required": [
        "text",
        "score",
        "token_count",
        "citation_id"
      ],
      "title": "Passage",
      "type": "object"
    },
    "RawMarkdown": {
      "properties": {
        "citation_id": {
          "title": "Citation Id",
          "type": "integer"
        },
        "markdown": {
          "title": "Markdown",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "markdown"
      ],
      "title": "RawMarkdown",
      "type": "object"
    },
    "SearchStats": {
      "properties": {
        "sub_queries": {
          "items": {
            "type": "string"
          },
          "title": "Sub Queries",
          "type": "array"
        },
        "discovery_status": {
          "default": "ok",
          "enum": [
            "ok",
            "degraded",
            "unavailable"
          ],
          "title": "Discovery Status",
          "type": "string"
        },
        "unresponsive_engines": {
          "items": {
            "$ref": "#/$defs/UnresponsiveEngine"
          },
          "title": "Unresponsive Engines",
          "type": "array"
        },
        "urls_discovered": {
          "default": 0,
          "title": "Urls Discovered",
          "type": "integer"
        },
        "urls_selected": {
          "default": 0,
          "title": "Urls Selected",
          "type": "integer"
        },
        "url_diagnostics": {
          "items": {
            "$ref": "#/$defs/UrlDiagnostic"
          },
          "title": "Url Diagnostics",
          "type": "array"
        },
        "urls_crawled_ok": {
          "default": 0,
          "title": "Urls Crawled Ok",
          "type": "integer"
        },
        "urls_crawled_failed": {
          "default": 0,
          "title": "Urls Crawled Failed",
          "type": "integer"
        },
        "pages_after_dedup": {
          "default": 0,
          "title": "Pages After Dedup",
          "type": "integer"
        },
        "pages_deduped": {
          "default": 0,
          "title": "Pages Deduped",
          "type": "integer"
        },
        "pages_cleaned": {
          "default": 0,
          "title": "Pages Cleaned",
          "type": "integer"
        },
        "markdown_chars_before": {
          "default": 0,
          "title": "Markdown Chars Before",
          "type": "integer"
        },
        "markdown_chars_after": {
          "default": 0,
          "title": "Markdown Chars After",
          "type": "integer"
        },
        "markdown_blocks_dropped": {
          "default": 0,
          "title": "Markdown Blocks Dropped",
          "type": "integer"
        },
        "markdown_cleaner_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown Cleaner Version"
        },
        "chunks_produced": {
          "default": 0,
          "title": "Chunks Produced",
          "type": "integer"
        },
        "chunks_prefiltered": {
          "default": 0,
          "title": "Chunks Prefiltered",
          "type": "integer"
        },
        "chunks_sent_to_reranker": {
          "default": 0,
          "title": "Chunks Sent To Reranker",
          "type": "integer"
        },
        "prefilter_strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefilter Strategy"
        },
        "reranker_batches": {
          "default": 0,
          "title": "Reranker Batches",
          "type": "integer"
        },
        "reranker_batches_failed": {
          "default": 0,
          "title": "Reranker Batches Failed",
          "type": "integer"
        },
        "reranker_floor_filled": {
          "default": false,
          "title": "Reranker Floor Filled",
          "type": "boolean"
        },
        "chunks_reranked": {
          "default": 0,
          "title": "Chunks Reranked",
          "type": "integer"
        },
        "passages_dropped_below_threshold": {
          "default": 0,
          "title": "Passages Dropped Below Threshold",
          "type": "integer"
        },
        "relevance_threshold_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance Threshold Policy"
        },
        "chunk_strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Strategy"
        },
        "embedding_degraded": {
          "default": false,
          "title": "Embedding Degraded",
          "type": "boolean"
        },
        "reranked": {
          "default": false,
          "title": "Reranked",
          "type": "boolean"
        },
        "tokens_returned": {
          "default": 0,
          "title": "Tokens Returned",
          "type": "integer"
        },
        "elapsed_ms": {
          "default": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "search_provider_unavailable",
                "no_results_from_discovery",
                "no_urls_after_selection",
                "all_crawls_failed",
                "no_chunks_after_dedup",
                "no_chunks_after_rerank"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "title": "SearchStats",
      "type": "object"
    },
    "UnresponsiveEngine": {
      "properties": {
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "reason"
      ],
      "title": "UnresponsiveEngine",
      "type": "object"
    },
    "UrlDiagnostic": {
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "discovery_score": {
          "title": "Discovery Score",
          "type": "number"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "selection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Reason"
        },
        "filtered_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filtered Reason"
        }
      },
      "required": [
        "url",
        "title",
        "engine",
        "discovery_score",
        "selected"
      ],
      "title": "UrlDiagnostic",
      "type": "object"
    }
  },
  "properties": {
    "query": {
      "title": "Query",
      "type": "string"
    },
    "passages": {
      "items": {
        "$ref": "#/$defs/Passage"
      },
      "title": "Passages",
      "type": "array"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "stats": {
      "$ref": "#/$defs/SearchStats"
    },
    "raw_markdown": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/RawMarkdown"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Markdown"
    },
    "schema_version": {
      "const": "thorondor.search.v1",
      "default": "thorondor.search.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "query",
    "passages",
    "citations",
    "stats"
  ],
  "title": "SearchResponse",
  "type": "object"
}
